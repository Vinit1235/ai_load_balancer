# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/

# ── Build / packaging ─────────────────────────────────────
build/
dist/
*.egg-info/

# ── Testing / tooling ─────────────────────────────────────
